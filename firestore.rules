rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Security Helper Functions ────────────────────────────────────
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function hasRole(r) {
      return isAuth() && 
             request.auth.token != null && 
             request.auth.token.keys().contains('role') && 
             request.auth.token.role == r;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }

    function isSupport() {
      return hasRole('support') || isAdmin();
    }

    function isEditor() {
      return hasRole('editor') || isAdmin();
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Global Config (appSettings, featureFlags, announcement, remoteConfig)
    // Anyone authenticated can READ, only super-admin can WRITE
    match /global_config/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Global Templates
    // Anyone authenticated can READ, only super-admin can WRITE/DELETE
    match /global_templates/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Audit Logs
    // Only super-admin can read; write is disabled for clients (Cloud Functions / Admin SDK write only)
    match /global_audit_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Per-User Data
    // Each user can read/write strictly their own sub-documents
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId);
    }

    // ── App Users (profile tracking for admin visibility)
    // Users can create/update their own profile, superadmin reads all
    match /app_users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isOwner(userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── App Visitors (anonymous device tracking)
    // Any visitor can create/update their own device record, superadmin reads all
    match /app_visitors/{deviceId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create, update: if true;
    }

    // ── Authoritative User Subscriptions
    // Users can read ONLY their own subscription; write is disabled for clients (Cloud Functions / Admin SDK only)
    match /user_subscriptions/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // ── Default Deny All Other Unmatched Paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
