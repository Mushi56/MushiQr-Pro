rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Security Helper Functions ────────────────────────────────────
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function hasRole(r) {
      return isAuth() && 
             request.auth.token != null && 
             request.auth.token.keys().contains('role') && 
             request.auth.token.role == r;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isAdmin() {
      return hasRole('admin') || isSuperAdmin();
    }

    function isSupport() {
      return hasRole('support') || isAdmin();
    }

    function isEditor() {
      return hasRole('editor') || isAdmin();
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function containsProtectedFields() {
      return request.resource.data.keys().hasAny(['role', 'isAdmin', 'subscription', 'plan', 'entitlement', 'isPro', 'permissions', 'admin']);
    }

    function containsAppUserProtectedFields() {
      return request.resource.data.keys().hasAny(['role', 'isPro', 'planId', 'subscriptionStatus', 'entitlement', 'permissions', 'admin', 'roleUpdatedAt', 'roleUpdatedBy', 'proGrantedAt', 'proGrantedBy']);
    }

    // ── Global Config (appSettings, featureFlags, announcement, remoteConfig)
    // Anyone authenticated can READ, only super-admin can WRITE
    match /global_config/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Global Templates
    // Anyone authenticated can READ, only super-admin can WRITE/DELETE
    match /global_templates/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Audit Logs
    // Only super-admin can read; write is disabled for clients (Cloud Functions / Admin SDK write only)
    match /global_audit_logs/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── Per-User Data
    // Each user can read/write strictly their own sub-documents (excluding protected security attributes)
    match /users/{userId}/{document=**} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if isOwner(userId) && !containsProtectedFields();
    }

    // ── App Users (profile tracking for admin visibility)
    // Users can update non-privileged profile fields; Super Admin manages all fields
    match /app_users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isOwner(userId) && !containsAppUserProtectedFields());
      allow update: if isSuperAdmin() || (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPro', 'planId', 'subscriptionStatus', 'entitlement', 'permissions', 'admin', 'roleUpdatedAt', 'roleUpdatedBy', 'proGrantedAt', 'proGrantedBy']));
      allow delete: if isSuperAdmin();
    }

    // ── App Visitors (anonymous device tracking)
    // Any visitor can register a device; updates are restricted to visitor telemetry attributes
    match /app_visitors/{deviceId} {
      allow get: if true;
      allow list: if isSuperAdmin();
      allow create: if true;
      allow update: if isSuperAdmin() || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastVisitAt', 'visitCount', 'linkedUid', 'updatedAt', 'deviceInfo', 'userAgent', 'platform']);
    }

    // ── Subscription Plan Configurations
    // Authenticated users can read plan configurations; client writes are disabled (Cloud Functions / Admin SDK only)
    match /subscription_plans/{planId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Authoritative User Subscriptions
    // Users can read ONLY their own subscription; write is disabled for clients (Cloud Functions / Admin SDK only)
    match /user_subscriptions/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    // ── Default Deny All Other Unmatched Paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
