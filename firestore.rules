rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'mabuneri143@gmail.com';
    }

    // ── Global Config (appSettings, featureFlags, announcement, remoteConfig)
    // Anyone authenticated can READ, only super-admin can WRITE
    match /global_config/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Global Templates
    // Anyone authenticated can READ, only super-admin can WRITE/DELETE
    match /global_templates/{docId} {
      allow read: if isAuth();
      allow write, delete: if isSuperAdmin();
    }

    // ── Audit Logs
    // Only super-admin can read/write
    match /global_audit_logs/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Per-User Data
    // Each user can read/write their own documents
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
