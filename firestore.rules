rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Security Helper Functions ────────────────────────────────────
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isSuperAdmin() {
      return isAuth() && 
             request.auth.token != null && 
             request.auth.token.email != null &&
             request.auth.token.email == 'mabuneri143@gmail.com' &&
             (request.auth.token.email_verified == true || request.auth.provider_id == 'google.com');
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // ── Global Config (appSettings, featureFlags, announcement, remoteConfig)
    // Anyone authenticated can READ, only super-admin can WRITE
    match /global_config/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ── Global Templates
    // Anyone authenticated can READ, only super-admin can WRITE/DELETE
    match /global_templates/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Audit Logs
    // Only super-admin can read/write
    match /global_audit_logs/{docId} {
      allow read, create, update, delete: if isSuperAdmin();
    }

    // ── Per-User Data
    // Each user can read/write strictly their own sub-documents
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ── App Users (profile tracking for admin visibility)
    // Users can create/update their own profile, superadmin reads all
    match /app_users/{userId} {
      allow read: if isSuperAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isSuperAdmin();
    }

    // ── App Visitors (anonymous device tracking)
    // Any visitor can create/update their own device record, superadmin reads all
    match /app_visitors/{deviceId} {
      allow read: if isSuperAdmin();
      allow create, update: if true;
    }

    // ── Default Deny All Other Unmatched Paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
